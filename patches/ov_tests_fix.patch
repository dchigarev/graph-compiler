+/// A rank>2 layout describes a 2D block IO only if all its batch dims are unit;
+/// the packed/transpose effects are then decided by the innermost two dims.
+/// Returns an empty range if `dims` is not such a layout.
+static ArrayRef<int64_t> innermost2D(ArrayRef<int64_t> dims) {
+  if (dims.size() < 2 ||
+      !llvm::all_of(dims.drop_back(2), [](int64_t d) { return d == 1; }))
+    return {};
+  return dims.take_back(2);
+}
