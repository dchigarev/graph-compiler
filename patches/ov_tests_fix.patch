+// Returns the descriptor shape for an nd block transfer of `shape`. Unit dims
+// (anywhere, not just leading) around a 2D tile carry no addressing
+// information beyond their offset, so they are dropped and their offsets
+// folded into the descriptor's base pointer, which is what XeVM's 2D-only
+// block load/store requires. A shape with more than two non-unit dims is a
+// true multi-dim block, kept as-is for the batch-unrolling passes to split.
+static SmallVector<int64_t> getBlockTransferDescShape(ArrayRef<int64_t> shape) {
+  if (shape.size() <= 2)
+    return llvm::to_vector(shape);
+  SmallVector<int64_t> nonUnit = llvm::to_vector(
+      llvm::make_filter_range(shape, [](int64_t d) { return d != 1; }));
+  return nonUnit.size() == 2 ? nonUnit : llvm::to_vector(shape);
+}
+
+// Builds a memref.subview that adapts `memref` to `ndDescShape`, the shape
+// getBlockTransferDescShape picked for the descriptor, so that every offset the
+// XeVM 2D block IO cannot express is folded into the subview's base pointer.
+// Each memref dim is classified as:
+//   - dropped: a leading dim beyond `descShape.size()` (not covered by the
+//     vector transfer at all), or a unit dim of `descShape` that `ndDescShape`
+//     dropped. A size-1 dim carries no addressing information beyond its
+//     offset, so the offset is folded in and the dim is rank-reduced away.
+//   - folded batch: a retained dim outside the innermost 2D tile. The 2D block
+//     IO has no offset for such a dim, and the batch-unrolling passes address
+//     it with offsets *relative to the tile*, so its (possibly dynamic) offset
+//     must be folded into the base pointer here. The dim itself is kept, sized
+//     to its tile extent, and its new offset is zero.
+//   - kept: the innermost two dims, addressed directly by the block IO.
+// The retained dims stay in their original relative order. Returns the new
+// memref and the matching offsets for the retained dims, in that order.
+static std::pair<Value, SmallVector<OpFoldResult>>
+convertMemrefAndOffsetsToBlockShape(PatternRewriter &rewriter, Location loc,
+                                    Value memref,
+                                    ArrayRef<OpFoldResult> offsets,
+                                    ArrayRef<int64_t> descShape,
+                                    ArrayRef<int64_t> ndDescShape) {
+  auto memrefType = cast<MemRefType>(memref.getType());
+  unsigned rank = memrefType.getRank();
+  unsigned leadingCount = rank - descShape.size();
+
+  SmallVector<unsigned> keptDims;
+  bool dropUnitDims = ndDescShape.size() != descShape.size();
+  for (auto [i, d] : llvm::enumerate(descShape))
+    if (d != 1 || !dropUnitDims)
+      keptDims.push_back(leadingCount + i);
+  assert(keptDims.size() == ndDescShape.size() &&
+         "retained dims must match the descriptor shape");
+
+  // Map each folded batch dim to its tile extent.
+  llvm::SmallDenseMap<unsigned, int64_t> batchDims;
+  for (unsigned i = 0, e = keptDims.size() > 2 ? keptDims.size() - 2 : 0; i < e;
+       ++i)
+    batchDims.try_emplace(keptDims[i], ndDescShape[i]);
+
+  if (keptDims.size() == rank && batchDims.empty())
+    return {memref, SmallVector<OpFoldResult>(offsets)};
+
+  llvm::SmallDenseSet<unsigned> keptSet(keptDims.begin(), keptDims.end());
+  SmallVector<OpFoldResult> subviewOffsets;
+  SmallVector<OpFoldResult> subviewSizes;
+  SmallVector<OpFoldResult> subviewStrides(rank, rewriter.getI64IntegerAttr(1));
+  SmallVector<int64_t> resultShape;
+  SmallVector<OpFoldResult> newOffsets;
+  ArrayRef<int64_t> originalShape = memrefType.getShape();
+  auto meta = memref::ExtractStridedMetadataOp::create(rewriter, loc, memref);
+  for (unsigned i = 0; i < rank; ++i) {
+    if (!keptSet.contains(i)) {
+      subviewOffsets.push_back(offsets[i]);
+      subviewSizes.push_back(rewriter.getI64IntegerAttr(1));
+    } else if (auto batch = batchDims.find(i); batch != batchDims.end()) {
+      subviewOffsets.push_back(offsets[i]);
+      subviewSizes.push_back(rewriter.getI64IntegerAttr(batch->second));
+      resultShape.push_back(batch->second);
+      newOffsets.push_back(rewriter.getI64IntegerAttr(0));
+    } else {
+      subviewOffsets.push_back(rewriter.getI64IntegerAttr(0));
+      if (ShapedType::isDynamic(originalShape[i])) {
+        subviewSizes.push_back(meta.getSizes()[i]);
+        resultShape.push_back(ShapedType::kDynamic);
+      } else {
+        subviewSizes.push_back(rewriter.getI64IntegerAttr(originalShape[i]));
+        resultShape.push_back(originalShape[i]);
+      }
+      newOffsets.push_back(offsets[i]);
+    }
+  }
+
+  auto resultType = memref::SubViewOp::inferRankReducedResultType(
+      resultShape, memrefType, subviewOffsets, subviewSizes, subviewStrides);
+  auto subviewOp =
+      memref::SubViewOp::create(rewriter, loc, resultType, memref,
+                                subviewOffsets, subviewSizes, subviewStrides);
+  return {subviewOp.getResult(), newOffsets};
+}
